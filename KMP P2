"""
Knuth-Morris-Pratt (KMP) Algorithm
-------------------------------------
Pre-processes the pattern to build a "failure function" (also called
the partial-match or LPS table).  During search, failed comparisons
reuse that table to skip redundant work instead of restarting from
scratch.

Time Complexity : O(n + m)   (preprocessing O(m), search O(n))
Space Complexity: O(m)       (for the LPS table)
"""


def build_lps(pattern: str) -> list[int]:
    """
    Build the Longest Proper Prefix which is also Suffix (LPS) table.

    lps[i] = length of the longest proper prefix of pattern[0..i]
             that is also a suffix of pattern[0..i].

    Example:
        pattern = "AABAAB"
        lps     = [0, 1, 0, 1, 2, 3]
    """
    m   = len(pattern)
    lps = [0] * m

    length = 0   # length of the previous longest prefix-suffix
    i      = 1   # lps[0] is always 0

    while i < m:
        if pattern[i] == pattern[length]:
            length += 1
            lps[i]  = length
            i       += 1
        else:
            if length != 0:
                # Try the shorter prefix (don't increment i)
                length = lps[length - 1]
            else:
                lps[i] = 0
                i      += 1

    return lps


def kmp_search(text: str, pattern: str) -> list[int]:
    """
    Returns all starting indices where `pattern` occurs in `text`.

    Args:
        text    : The source string to search in.
        pattern : The string to search for.

    Returns:
        List of starting positions (0-indexed) where a match is found.
    """
    n       = len(text)
    m       = len(pattern)
    matches = []

    if m == 0:
        return matches

    lps = build_lps(pattern)

    i = 0   # index into text
    j = 0   # index into pattern

    while i < n:
        if text[i] == pattern[j]:
            i += 1
            j += 1

        if j == m:
            # Full match found; record the start position
            matches.append(i - j)
            # Use LPS table to slide pattern (avoid re-checking known chars)
            j = lps[j - 1]

        elif i < n and text[i] != pattern[j]:
            if j != 0:
                # Skip characters we already know match via LPS
                j = lps[j - 1]
            else:
                i += 1

    return matches


# ── Demo ──────────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    text    = "AABAACAADAABAABA"
    pattern = "AABA"

    lps     = build_lps(pattern)
    results = kmp_search(text, pattern)

    print("Text   :", text)
    print("Pattern:", pattern)
    print("LPS    :", lps)
    print("Found at indices:", results)

    for idx in results:
        print(f"  [{idx}] {text[idx : idx + len(pattern)]}")
